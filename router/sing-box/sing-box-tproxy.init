#!/bin/sh /etc/rc.common
# Install/remove the nftables TPROXY rules and policy routing for sing-box.
# START=99 ensures it runs after the sing-box service (also START=99, name sorts first).
START=99
STOP=10

start() {
	# wait up to 10s for sing-box's tproxy listener
	i=0
	while [ "$i" -lt 10 ]; do
		ss -lnt 2>/dev/null | grep -q ':7895 ' && break
		sleep 1
		i=$((i + 1))
	done

	nft list table inet sing_box >/dev/null 2>&1 && nft delete table inet sing_box
	nft -f /etc/sing-box/tproxy.nft || return 1

	ip rule del fwmark 1 lookup 100 2>/dev/null
	ip rule add fwmark 1 lookup 100
	ip route replace local 0.0.0.0/0 dev lo table 100
}

stop() {
	nft delete table inet sing_box 2>/dev/null
	ip rule del fwmark 1 lookup 100 2>/dev/null
	ip route flush table 100 2>/dev/null
	return 0
}
