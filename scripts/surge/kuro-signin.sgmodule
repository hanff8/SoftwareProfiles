#!name=库街区自动签到（抓凭证+签到）
#!desc=零配置可用。参数可设置 capture 启停、签到启停、每天签到时间。
#!arguments=enable_capture:true,enable_signin:true,signin_hour:8,signin_minute:0
#!arguments-desc=enable_capture/enable_signin 填 true 或 false；signin_hour 为小时(0-23)，signin_minute 为分钟(0-59)。

[MITM]
hostname = api.kurobbs.com

[Script]
kuro.capture = type=http-request,pattern=^https://api\.kurobbs\.com/,script-path=https://raw.githubusercontent.com/hanff8/SoftwareProfiles/master/scripts/surge/kuro-capture.js,argument="{{{enable_capture}}}"
kuro.signin = type=cron,cronexp="{{{signin_minute}}} {{{signin_hour}}} * * *",script-path=https://raw.githubusercontent.com/hanff8/SoftwareProfiles/master/scripts/surge/kuro-signin.js,timeout=120,argument="{{{enable_signin}}}"
