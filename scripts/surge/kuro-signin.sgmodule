#!name=库街区自动签到（抓凭证+签到）
#!desc=启用后无需配置：开启 MITM，打开库街区 App 触发抓凭证，之后每天定时自动签到。

[MITM]
hostname = api.kurobbs.com

[Script]
kuro.capture = type=http-request,pattern=^https://api\.kurobbs\.com/,script-path=https://raw.githubusercontent.com/hanff8/SoftwareProfiles/master/scripts/surge/kuro-capture.js
kuro.signin = type=cron,cronexp="0 8 * * *",script-path=https://raw.githubusercontent.com/hanff8/SoftwareProfiles/master/scripts/surge/kuro-signin.js,timeout=120
